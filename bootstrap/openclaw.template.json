{
  "agents": {
    "defaults": {
      "workspace": "__REPLACE_WITH_WORKSPACE_PATH__",
      "model": {
        "primary": "__REPLACE_WITH_MODEL_ID__"
      },
      "heartbeat": {
        "model": "__REPLACE_WITH_MODEL_ID__",
        "lightContext": true,
        "isolatedSession": true
      }
    }
  },
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "loopback",
    "tailscale": {
      "mode": "off"
    }
  },
  "plugins": {
    "entries": {
      "memory-core": {
        "enabled": false,
        "config": {
          "dreaming": {
            "enabled": false
          }
        }
      }
    }
  },
  "channels": {
    "googlechat": {
      "enabled": false,
      "allowBots": false
    },
    "feishu": {
      "enabled": false,
      "dmPolicy": "allowlist",
      "allowFrom": [],
      "groupPolicy": "allowlist",
      "requireMention": true,
      "groupAllowFrom": []
    },
    "telegram": {
      "enabled": false,
      "dmPolicy": "allowlist",
      "allowFrom": [],
      "configWrites": false,
      "groupAllowFrom": []
    }
  },
  "update": {
    "auto": {
      "enabled": false
    },
    "checkOnStart": false
  },
  "proxy": {
    "enabled": false
  }
}
